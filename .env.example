# Generate a unique local password and set it here before starting Docker Compose.
POSTGRES_PASSWORD=
# Leave blank to keep admin moderation disabled.
ADMIN_API_KEY=
# Generate a random secret of at least 32 bytes for signing chat session cookies.
CHAT_SESSION_SECRET=
# Set these when the deployed frontend/API use different public origins.
ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
